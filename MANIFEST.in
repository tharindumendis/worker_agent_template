# MANIFEST.in
# ---------------------------------------------------------------------------
# Controls which *extra* files are included in the source distribution
# (python -m build --sdist).  Wheel builds use package_data in setup.py.
# ---------------------------------------------------------------------------

# Always include
include README.md
include LICENSE
include CHANGELOG.md
include config.yaml
include requirements.txt
include pyproject.toml

# Include the entire core package source
recursive-include core *.py *.yaml *.yml *.json *.md

# Include tests (so contributors can run them from the sdist)
recursive-include tests *.py *.yaml *.json

# PEP 561 typed-package marker
include py.typed

# Exclude build artefacts and caches
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.egg-info
prune .venv
prune .git
prune dist
prune build
prune logs
